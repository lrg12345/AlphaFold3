#!/bin/bash --login
#SBATCH --job-name=af3_ProtProt_cofold
#SBATCH --time=03:00:00
#SBATCH --gpus=a100:1
#SBATCH --constraint=nal
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --output=/mnt/gs21/scratch/needsang/AlphaFold/logs/%x_%A_%a.out # CHANGE ME
#SBATCH --error=/mnt/gs21/scratch/needsang/AlphaFold/logs/%x_%A_%a.err # CHANGE ME
#SBATCH --array=1-1 # CHANGE ME

set -euo pipefail

module purge

export AF3_PERSONAL_DIR=/mnt/scratch/needsang/AlphaFold/ # CHANGE ME
export AF3_RESOURCES_DIR=/mnt/research/woldring_lab/AlphaFold3 # CHANGE ME
export AF3_SCRATCH_DIR=/mnt/scratch/needsang/AlphaFold/ # CHANGE ME

CSV_PATH="${AF3_PERSONAL_DIR}/inputs/af3_ProtProt_cofold.csv" # CHANGE ME
AF3_JSON_TMPLT="${AF3_PERSONAL_DIR}/inputs/af3_ProtProt_template.json" # CHANGE ME

export AF3_IMAGE="${AF3_RESOURCES_DIR}/image/alphafold3.sif"
export AF3_CODE_DIR="${AF3_RESOURCES_DIR}/code"
export AF3_INPUT_DIR="${AF3_SCRATCH_DIR}/inputs"
export AF3_OUTPUT_DIR="${AF3_SCRATCH_DIR}/outputs"
export AF3_MODEL_PARAMETERS="${AF3_RESOURCES_DIR}/weights"
export AF3_DATABASES_DIR=/mnt/research/common-data/alphafold/database_3

mkdir -p "${AF3_INPUT_DIR}" "${AF3_OUTPUT_DIR}" "${AF3_SCRATCH_DIR}/logs" "${AF3_SCRATCH_DIR}/tmp"

# Total structures per run is AF3_NUM_SEEDS x AF3_NUM_SAMPLES_PER_SEED
AF3_NUM_SEEDS="${AF3_NUM_SEEDS:-5}"
AF3_NUM_SAMPLES_PER_SEED="${AF3_NUM_SAMPLES_PER_SEED:-5}"

# ---- sanity checks ----
[[ -f "${CSV_PATH}" ]] || { echo "ERROR: CSV not found: ${CSV_PATH}" >&2; exit 1; }
[[ -f "${AF3_JSON_TMPLT}" ]] || { echo "ERROR: Template JSON not found: ${AF3_JSON_TMPLT}" >&2; exit 1; }
[[ -f "${AF3_IMAGE}" ]] || { echo "ERROR: AF3 image not found: ${AF3_IMAGE}" >&2; exit 1; }
[[ -d "${AF3_CODE_DIR}" ]] || { echo "ERROR: AF3 code dir not found: ${AF3_CODE_DIR}" >&2; exit 1; }
[[ -d "${AF3_MODEL_PARAMETERS}" ]] || { echo "ERROR: Model parameters dir not found: ${AF3_MODEL_PARAMETERS}" >&2; exit 1; }
[[ -d "${AF3_DATABASES_DIR}" ]] || { echo "ERROR: Databases dir not found: ${AF3_DATABASES_DIR}" >&2; exit 1; }

af3_supports_flag() {
  local flag="$1"
  singularity exec "${AF3_IMAGE}" /bin/bash -lc \
    "python3 /root/af_code/alphafold3/run_alphafold.py --helpshort 2>/dev/null | grep -q -- '${flag}'"
}

# -------- JSON BUILDER (protein-protein docking) --------
make_json() {
  local target_id="$1"
  local target_sequence="$2"
  local out_json="$3"
  local n_seeds="$4"
  local binder_id="$5"
  local binder_sequence="$6"

  python3 - "${AF3_JSON_TMPLT}" "${out_json}" "${target_id}" "${target_sequence}" "${n_seeds}" "${binder_id}" "${binder_sequence}" <<'PY'
import json, sys, zlib

tmpl_path, out_path, target_id, target_seq, n_seeds, binder_id, binder_seq = sys.argv[1:]

n_seeds = int(n_seeds)
if n_seeds < 1:
    n_seeds = 1

target_seq = ''.join(target_seq.split()).upper()
binder_seq = ''.join(binder_seq.split()).upper()

with open(tmpl_path, 'r') as f:
    data = json.load(f)

data['name'] = f"{target_id}_{binder_id}"

# ---- proteins ----
protein_entries = [item['protein'] for item in data.get('sequences',[]) if 'protein' in item]

if len(protein_entries) <2:
  raise RuntimeError(f"Template JSON needs at least 2 protein entries. Found: {len(protein_entries)}")

protein_entries[0]['sequence'] = target_seq
protein_entries[1]['sequence'] = binder_seq

# ---- seeds ----
max_seed = 2147483647
seed_string = f"{target_id}{binder_id}".encode('utf-8')
base_seed = (zlib.crc32(seed_string) % (max_seed - 1)) + 1

seeds = []
for i in range(n_seeds):
    s = (base_seed + i) % max_seed
    seeds.append(int(s if s != 0 else 1))

data['modelSeeds'] = seeds

with open(out_path, 'w') as f:
    json.dump(data, f, indent=2)
PY
}

# -------- GRAB CSV ROW --------
row_tsv="$(python3 - "${CSV_PATH}" "${SLURM_ARRAY_TASK_ID}" <<'PY'
import csv, sys

path = sys.argv[1]
idx = int(sys.argv[2])

with open(path, newline='') as f:
    r = csv.DictReader(f)
    need = {'target_id', 'target_sequence','binder_id','binder_sequence'}
    if not r.fieldnames or (need - set(r.fieldnames)):
        raise SystemExit(f"CSV must have columns: {sorted(need)}; found: {r.fieldnames}")

    for i, row in enumerate(r, start=1):
        if i == idx:
            target_id = row['target_id'].strip()
            target_seq = row['target_sequence'].strip()
            binder_id = row['binder_id'].strip()
            binder_seq = row['binder_sequence'].strip()
            if not target_id:
                raise SystemExit(f'Row {idx}: empty target_id')
            if not target_seq:
                raise SystemExit(f'Row {idx}: empty target_sequence')
            if not binder_id:
                raise SystemExit(f'Row {idx}: empty binder_id')
            if not binder_seq:
                raise SystemExit(f'Row {idx}: empty binder_sequence')
            print(f'{target_id}\t{target_seq}\t{binder_id}\t{binder_seq}')
            break
    else:
        raise SystemExit(f'No row {idx} in CSV (data rows only).')
PY
)"

IFS=$'\t' read -r target_id target_sequence binder_id binder_sequence <<< "${row_tsv}"

job_tag="${target_id}_${binder_id}"
json_host="${AF3_INPUT_DIR}/${job_tag}.json"
out_host="${AF3_OUTPUT_DIR}/${job_tag}"

mkdir -p "${out_host}"

AF3_TMP_HOST="${AF3_SCRATCH_DIR}/tmp/${job_tag}_${SLURM_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "${AF3_TMP_HOST}"

echo "==> [task ${SLURM_ARRAY_TASK_ID}] job_tag=${job_tag}"
echo "==> writing JSON: ${json_host}"

make_json "${target_id}" "${target_sequence}" "${json_host}" "${AF3_NUM_SEEDS}" "${binder_id}" "${binder_sequence}"

# ---- diffusion args only if supported ----
diffusion_args=()
if af3_supports_flag 'num_diffusion_samples'; then
  diffusion_args+=(--num_diffusion_samples "${AF3_NUM_SAMPLES_PER_SEED}")
fi

echo "==> running AF3 in ${out_host}"
singularity exec --nv \
  --bind "${AF3_INPUT_DIR}:/root/af_input" \
  --bind "${AF3_OUTPUT_DIR}:/root/af_output" \
  --bind "${AF3_MODEL_PARAMETERS}:/root/models" \
  --bind "${AF3_DATABASES_DIR}:/root/public_databases" \
  --bind "${AF3_CODE_DIR}:/root/af_code" \
  --bind "${AF3_TMP_HOST}:/tmp/local" \
  --env TMPDIR=/tmp/local \
  "${AF3_IMAGE}" \
  python3 /root/af_code/alphafold3/run_alphafold.py \
    --json_path "/root/af_input/${job_tag}.json" \
    --model_dir /root/models \
    --db_dir /root/public_databases \
    --output_dir "/root/af_output/${job_tag}" \
    "${diffusion_args[@]}"
